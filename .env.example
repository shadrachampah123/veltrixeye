# VeltrixEye — environment template (root: API + local dev database).
# Copy to `.env` (or run `npm run setup`, which generates one with a random
# local database password). NEVER commit real values.
# Full documentation: docs/environment.md

NODE_ENV=development

# --- Database ---
# Local development: embedded Postgres started by `npm run db:dev`
# (see scripts/db/dev-up.mjs). Production: any hosted Postgres 14+
# (Neon, RDS, Supabase, …) — you provide the real credentials; this repo
# never contains production secrets.
DATABASE_URL=postgres://veltrix:CHANGE_ME@127.0.0.1:5433/veltrixeye
# disable | require | verify-full
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10

# --- API server ---
PORT=4000
HOST=0.0.0.0
# Session lifetime in days (max 90)
SESSION_TTL_DAYS=30
# Session cookie name
SESSION_COOKIE_NAME=ve_session
# auto (secure in production) | always | never
COOKIE_SECURE=auto
# fastify log level
LOG_LEVEL=info

# --- Reverse-proxy trust (which IP counts as "the client") ---
# `req.ip` keys every rate limit and is what audit_events.ip / sessions.ip
# record. Fastify derives it by walking X-Forwarded-For from the socket outward
# and stopping at the first address NOT listed here, so this list decides who
# may speak for the client. The default pins exactly the production chain
# (Render's internal hops + Cloudflare's published edge ranges, since all
# Render web traffic enters through Cloudflare) — leave it unset.
# Setting the variable REPLACES the default (it does not append). A /0 entry
# ("trust everybody") is rejected at boot, as is any malformed address.
# Add Vercel's Static IP egress addresses here if you enable them, so
# web-proxied traffic gets per-browser buckets instead of one shared bucket.
# Full value list + rationale: docs/environment.md, apps/api/src/trust-proxy.ts
#TRUSTED_PROXY_CIDRS=loopback,linklocal,uniquelocal,173.245.48.0/20

# --- Alert notification delivery (M7.3: email / SMTP) ---
# Leave SMTP_HOST and NOTIFICATION_FROM empty to run WITHOUT email delivery:
# alert notifications are still queued durably, and the worker records them as
# "unavailable" — never as delivered. Set them (plus the credentials) in the
# deployment environment to switch delivery on; no code change is required.
# Server-side only: the SMTP password is never logged and never returned by any
# route. NEVER commit a real value.
#SMTP_HOST=
#SMTP_PORT=587
# auto (implicit TLS on port 465 only, STARTTLS otherwise) | always | never
#SMTP_SECURE=auto
#SMTP_USER=
#SMTP_PASS=
#NOTIFICATION_FROM=
# --- Delivery worker / retry tuning (defaults are production-sane) ---
#NOTIFICATION_PROVIDER_TIMEOUT_MS=15000
#NOTIFICATION_MAX_ATTEMPTS=5
#NOTIFICATION_BACKOFF_BASE_MS=30000
#NOTIFICATION_BACKOFF_MAX_MS=3600000
#NOTIFICATION_BACKOFF_JITTER_MS=5000
#NOTIFICATION_LEASE_MS=120000
# true | false — run the worker inside the API process on an interval
#NOTIFICATION_WORKER_ENABLED=true
#NOTIFICATION_WORKER_INTERVAL_MS=60000
#NOTIFICATION_WORKER_BATCH_SIZE=25
#NOTIFICATION_RETENTION_DELIVERED_DAYS=30
#NOTIFICATION_RETENTION_FAILED_DAYS=120
# Shared secret for POST /api/internal/notifications/deliveries/* (an external
# cron job can drain the queue through it). EMPTY = those routes return 404.
#NOTIFICATION_WORKER_TOKEN=

# --- Market data (M2: Twelve Data, historical) ---
# Server-side provider key. Leave empty for foundation-only dev (the API
# boots; market-data routes answer 502 until a key is set). Production
# user-facing display requires a Business (Venture+) plan — see
# docs/provider-licensing.md. NEVER commit a real key.
#TWELVE_DATA_API_KEY=
#TWELVE_DATA_BASE_URL=https://api.twelvedata.com
#TWELVE_DATA_TIMEOUT_MS=15000
#TWELVE_DATA_MAX_RPM=50
#TWELVE_DATA_CRYPTO_EXCHANGE=Binance

# --- Live scanner (M7.5: production market-data and scanner pipeline) ---
# The scanner processes real market data through the full strategy pipeline:
# Market Data → Normalization → Validation/Freshness → Strategy Detection
# → Setup Qualification → Scoring → Risk/Quality Validation → Alert Generation
# → Notification Outbox. It uses Twelve Data (historical) as the production
# provider, advisory locking to prevent overlapping scans, and cursors to avoid
# re-processing the same candle. Disabled by default in dev; enable in prod
# or trigger manually via POST /api/scanner/trigger.
# true | false — run the scanner inside the API process on an interval
#SCANNER_ENABLED=false
#SCANNER_INTERVAL_MS=300000
#SCANNER_PROVIDER_TIMEOUT_MS=15000
#SCANNER_MAX_RETRIES=3
#SCANNER_RETRY_BASE_MS=1000
#SCANNER_RETRY_MAX_MS=10000

# --- Execution architecture (M8.1) ---
# M8.1 introduces NO new environment variables: it ships the execution
# architecture and safety boundary only (no broker, no orders). Automation is
# OFF for every plan, and live execution is impossible. Future execution
# providers (paper simulation in M8.3, then demo/broker bridges) will take
# their credentials from server-side environment/secret management only —
# never from the database, never exposed to clients. See docs/execution.md.

# --- Safety controls (M8.6) ---
# Deployment-level GLOBAL kill switch. `true` pins the platform-wide emergency
# stop ON for every account regardless of database state: new execution
# (automation gates AND paper simulation) is refused everywhere, and the stop
# cannot be cleared through any API — only by changing this environment value
# and redeploying. Strict boolean; absent/false = clear. It GRANTS nothing
# (live execution remains impossible by construction) — it only stops.
#EXECUTION_GLOBAL_KILL_SWITCH=false

# M10 non-live execution transport foundation. Does not wire a route or worker.
# Allowed: disabled (default), dry-run. mt5-live always fails startup in M10.
# Dry-run/disabled require no MT5 credentials. Never add real MT5 secrets here.
EXECUTION_TRANSPORT_MODE=disabled
EXECUTION_TRANSPORT_TIMEOUT_MS=5000

# --- Billing (PR3) — SANDBOX ONLY ---
# Empty = billing is unavailable: no provider is registered, no plan can be
# provisioned and no payment can be initialized (fail closed). When set, the
# value MUST be a sandbox test secret key: a live key (sk_live_...) or a public
# key (pk_...) fails startup, and the adapter refuses anything but sk_test_.
# Server-side only: never commit a real key, never expose one to a browser.
#PAYSTACK_SECRET_KEY=
# Single-attempt request timeout (ms). There is no retry, and no configurable
# base URL — the adapter only ever talks to https://api.paystack.co.
#PAYSTACK_TIMEOUT_MS=15000

# --- Billing Step 5.2 — secure webhook receiver (POST /api/billing/webhook) ---
# The route exists ONLY when PAYSTACK_SECRET_KEY is set. Deliveries are
# admitted only from this allow-list (comma/whitespace-separated IPs/CIDRs);
# EMPTY pins the provider's DOCUMENTED webhook source addresses
# (52.31.139.75, 52.49.173.169, 52.214.14.220 — same set in test and live).
# Widen it per deployment when needed (e.g. "127.0.0.1, ::1" for local
# testing). A /0 entry is refused at boot. Defence in depth: the
# x-paystack-signature HMAC-SHA512 check remains the authority.
#PAYSTACK_WEBHOOK_ALLOWED_IPS=
# Deliveries per minute per IP accepted on the webhook route (1-1000). Well
# above the provider's documented delivery/retry cadence, well below the
# global API limit — an unsigned flood stops here.
#PAYSTACK_WEBHOOK_RATE_LIMIT_MAX=30
