# VeltrixEye — environment template (root: API + local dev database).
# Copy to `.env` (or run `npm run setup`, which generates one with a random
# local database password). NEVER commit real values.
# Full documentation: docs/environment.md

NODE_ENV=development

# --- Database ---
# Local development: embedded Postgres started by `npm run db:dev`
# (see scripts/db/dev-up.mjs). Production: any hosted Postgres 14+
# (Neon, RDS, Supabase, …) — you provide the real credentials; this repo
# never contains production secrets.
DATABASE_URL=postgres://veltrix:CHANGE_ME@127.0.0.1:5433/veltrixeye
# disable | require | verify-full
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10

# --- API server ---
PORT=4000
HOST=0.0.0.0
# Session lifetime in days (max 90)
SESSION_TTL_DAYS=30
# Session cookie name
SESSION_COOKIE_NAME=ve_session
# auto (secure in production) | always | never
COOKIE_SECURE=auto
# fastify log level
LOG_LEVEL=info
