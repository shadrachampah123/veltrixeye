# VeltrixEye — environment template (root: API + local dev database).
# Copy to `.env` (or run `npm run setup`, which generates one with a random
# local database password). NEVER commit real values.
# Full documentation: docs/environment.md

NODE_ENV=development

# --- Database ---
# Local development: embedded Postgres started by `npm run db:dev`
# (see scripts/db/dev-up.mjs). Production: any hosted Postgres 14+
# (Neon, RDS, Supabase, …) — you provide the real credentials; this repo
# never contains production secrets.
DATABASE_URL=postgres://veltrix:CHANGE_ME@127.0.0.1:5433/veltrixeye
# disable | require | verify-full
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10

# --- API server ---
PORT=4000
HOST=0.0.0.0
# Session lifetime in days (max 90)
SESSION_TTL_DAYS=30
# Session cookie name
SESSION_COOKIE_NAME=ve_session
# auto (secure in production) | always | never
COOKIE_SECURE=auto
# fastify log level
LOG_LEVEL=info

# --- Reverse-proxy trust (which IP counts as "the client") ---
# `req.ip` keys every rate limit and is what audit_events.ip / sessions.ip
# record. Fastify derives it by walking X-Forwarded-For from the socket outward
# and stopping at the first address NOT listed here, so this list decides who
# may speak for the client. The default pins exactly the production chain
# (Render's internal hops + Cloudflare's published edge ranges, since all
# Render web traffic enters through Cloudflare) — leave it unset.
# Setting the variable REPLACES the default (it does not append). A /0 entry
# ("trust everybody") is rejected at boot, as is any malformed address.
# Add Vercel's Static IP egress addresses here if you enable them, so
# web-proxied traffic gets per-browser buckets instead of one shared bucket.
# Full value list + rationale: docs/environment.md, apps/api/src/trust-proxy.ts
#TRUSTED_PROXY_CIDRS=loopback,linklocal,uniquelocal,173.245.48.0/20

# --- Market data (M2: Twelve Data, historical) ---
# Server-side provider key. Leave empty for foundation-only dev (the API
# boots; market-data routes answer 502 until a key is set). Production
# user-facing display requires a Business (Venture+) plan — see
# docs/provider-licensing.md. NEVER commit a real key.
#TWELVE_DATA_API_KEY=
#TWELVE_DATA_BASE_URL=https://api.twelvedata.com
#TWELVE_DATA_TIMEOUT_MS=15000
#TWELVE_DATA_MAX_RPM=50
#TWELVE_DATA_CRYPTO_EXCHANGE=Binance
