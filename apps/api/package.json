{
  "name": "@veltrixeye/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VeltrixEye HTTP API (Fastify)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@veltrixeye/contracts": "*",
    "@veltrixeye/core": "*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
