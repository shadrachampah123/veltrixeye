# VeltrixEye web app — environment template.
# Copy to .env.local (or run `npm run setup`, which generates one).
# Full documentation: docs/environment.md

# Server-side (Next.js) base URL of the API. The web app proxies /api/*
# to this address in next.config.mjs. Browsers always call same-origin
# /api/... only — this value is never sent to the client.
#
# The rewrite destination is compiled at BUILD time, so in production set
# this in the Vercel project and redeploy after changing it:
#   Vercel → Settings → Environment Variables → API_INTERNAL_BASE
#     Production: https://<your-api-host>     (required; the build fails
#                                              without it, or if it is not https)
#     Preview:    https://<your-api-host>     (optional, for PR previews)
# See docs/deployment.md.
API_INTERNAL_BASE=http://127.0.0.1:4000
